{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spine Emulators",
  "mainBinaryName": "Spine-Emulators",
  "version": "0.37.1",
  "identifier": "app.spine.emulators",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spine Emulators",
        "width": 980,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#101218"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Installs emulators for Spine",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
