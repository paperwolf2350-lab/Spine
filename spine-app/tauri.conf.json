{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spine",
  "version": "0.2.0",
  "identifier": "app.spine.frontend",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spine",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#F6F2EA"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
