{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spine",
  "mainBinaryName": "Spine",
  "version": "0.45.0",
  "identifier": "app.spine.frontend",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Spine",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#F6F2EA",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' http://spine.localhost spine://localhost https://fonts.googleapis.com; font-src 'self' http://spine.localhost spine://localhost https://fonts.gstatic.com; img-src 'self' data: blob: http://spine.localhost spine://localhost https: http:; media-src 'self' blob: http://spine.localhost spine://localhost; connect-src 'self' http://spine.localhost spine://localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Spine",
    "shortDescription": "Your game library, like a console",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "category": "Game",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "curl"
        ]
      }
    }
  }
}